        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  // Fallback: strip any accidental markdown fences\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n}\n\nconst emailData = $('Gmail Trigger').first().json;\n\nreturn [{\n  json: {\n    urgency: parsed.urgency,\n    urgency_reason: parsed.urgency_reason,\n    draft_reply: parsed.draft_reply,\n    original_subject: emailData.subject,\n    original_from: emailData.from.value[0].address,\n    thread_id: emailData.threadId,\n    message_id: emailData.id\n  }\n}];"
      },
